 "type": "module",
 "types": "./lib/types.d.ts",
 "version": "25.14.0",
 "wireit": {
  "build": {
   "dependencies": [
    "build:tsc",
    "build:types"
   ]
  },
  "build:docs": {
   "command": "api-extractor run --local --config \"./api-extractor.docs.json\"",
   "dependencies": [
    "build:tsc"
   ],
   "files": [
    "api-extractor.docs.json",
    "lib/puppeteer/puppeteer.docs.d.ts",
    "tsconfig.json"
   ]
  },
  "build:tsc": {
   "clean": "if-file-deleted",
   "command": "tsc -b && node --experimental-strip-types ../../tools/chmod.ts 755 lib/puppeteer/node/cli.js",
   "dependencies": [
    "../puppeteer-core:build",
    "../browsers:build"
   ],
   "files": [
    "src/**"
   ],
   "output": [
    "lib/**",
    "!lib/package.json"
   ]
  },
  "build:types": {
   "command": "api-extractor run --local && eslint --fix lib/types.d.ts --no-ignore",
   "dependencies": [
    "build:tsc"
   ],
   "files": [
    "api-extractor.json",
    "lib/puppeteer/types.d.ts",
    "tsconfig.json"
   ],
   "output": [
    "lib/types.d.ts"
   ]
  },
  "prepack": {
   "command": "node --experimental-strip-types ../../tools/cp.ts ../../README.md README.md",
   "files": [
    "../../README.md"
   ],
   "output": [
    "README.md"
   ]
  },
  "unit": {
   "command": "node --test --test-reporter=spec \"lib/**/*.test.js\"",
   "dependencies": [
    "build"
   ]
  },
  "unit:only": {
   "command": "node --test --test-only --test-reporter=spec \"lib/**/*.test.js\"",
   "dependencies": [
    "build"
   ]
  }
 }
