 "scripts": {
  "build": "wireit",
  "build:docs": "wireit",
  "check": "wireit",
  "clean": "../../tools/clean.mjs",
  "prepack": "wireit",
  "unit": "wireit",
  "unit:only": "wireit"
 },
 "type": "module",
 "types": "./lib/types.d.ts",
 "version": "25.14.0",
 "wireit": {
  "build": {
   "dependencies": [
    "build:tsc",
    "build:types",
    "build:es5"
   ]
  },
  "build:docs": {
   "command": "api-extractor run --local --config \"./api-extractor.docs.json\"",
   "dependencies": [
    "build:tsc"
   ],
   "files": [
    "api-extractor.docs.json",
    "lib/puppeteer/puppeteer-core.d.ts",
    "tsconfig.json"
   ]
  },
  "build:es5": {
   "command": "rollup -c rollup.config.mjs && node ../../tools/patch.mjs lib/es5-iife/puppeteer-core-browser.js lib/es5-iife/puppeteer-core-browser.d.ts lib/types.d.ts",
   "dependencies": [
    "build:tsc",
    "build:types"
   ],
   "files": [
    "rollup.config.mjs"
   ],
   "output": [
    "lib/es5-iife/puppeteer-core-browser.js"
   ]
  },
  "build:tsc": {
   "clean": "if-file-deleted",
   "command": "hereby build",
   "dependencies": [
    "../browsers:build"
   ],
   "files": [
    "{src,third_party}/**",
    "../../versions.js",
    "!src/generated",
    "Herebyfile.mjs"
   ],
   "output": [
    "lib/**"
   ]
  },
  "build:types": {
   "command": "api-extractor run --local && eslint --fix lib/types.d.ts --no-ignore",
   "dependencies": [
    "build:tsc"
   ],
   "files": [
    "api-extractor.json",
    "lib/puppeteer/types.d.ts",
    "tsconfig.json"
   ],
   "output": [
    "lib/types.d.ts"
   ]
  },
  "check": {
   "command": "node --experimental-strip-types tools/ensure-correct-devtools-protocol-package.mts",
   "dependencies": [
    "build"
   ]
  },
  "prepack": {
   "command": "node --experimental-strip-types ../../tools/cp.ts ../../README.md README.md",
   "files": [
    "../../README.md"
   ],
   "output": [
    "README.md"
   ]
  },
  "unit": {
   "command": "node --test --test-reporter=spec \"lib/**/*.test.js\"",
   "dependencies": [
    "build"
   ]
  },
  "unit:only": {
   "command": "node --test --test-only --test-reporter=spec \"lib/**/*.test.js\"",
   "dependencies": [
    "build"
   ]
  }
 }
