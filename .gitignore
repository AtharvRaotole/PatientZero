# env / secrets (only .env.example is tracked)
.env
.env.*
!.env.example
*.env.local
*.pem
*.key
*.p12
# local FalkorDB runtime (module binary downloaded by scripts/start-falkordb.sh, data, logs)
.falkordb/
*.rdb
# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
# node / next
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
# misc
.DS_Store
Thumbs.db
*.log
*.swp
.idea/
.vscode/
# explicit (also covered by patterns above / frontend/.gitignore)
backend/.venv/
ingest/.venv/
frontend/node_modules/
frontend/.next/
.cache/
# BYO scan cache: only the committed demo set (axios, express 4.x, express v5, vercel/ms and a few more) is
# tracked; new scans write here at runtime and stay local.
data/raw/byo/**

# demo video artifacts (large / regenerated)
demo/*.mp4
demo/raw/
demo/frames/
demo/beats.json
demo/vo/
