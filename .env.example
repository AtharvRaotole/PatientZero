# FalkorDB. Local: scripts/start-falkordb.sh. FalkorDB Cloud: set FALKORDB_URL (rediss://user:pass@host:port)
# or HOST/PORT/USERNAME/PASSWORD (+ FALKORDB_SSL=true).
FALKORDB_URL=
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH=fleet:acme

# Backend CORS (comma list) and optional regex, e.g. https://.*\.vercel\.app
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
CORS_ORIGIN_REGEX=

# Frontend (must be reachable from the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional OpenAI tool calling. Without a key everything runs on the deterministic router.
# auto: router first, LLM only when the router is not confident | deterministic | llm
AGENT_MODE=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS_TOOLS=400
LLM_MAX_TOKENS_SUMMARY=250
LLM_CACHE_TTL=1800

# Bring your own repo (BYO) scans. Deterministic: no LLM involved.
# Scans per minute per client IP (in-memory); scan graph lifetime in seconds (6 h); max live scan graphs;
# seconds per scan request.
BYO_RATE_LIMIT=5
BYO_TTL_SECONDS=21600
BYO_MAX_GRAPHS=50
BYO_SCAN_TIMEOUT=60

# Production single-service deploy (Dockerfile). Locally, Next.js dev serves the UI instead.
# FRONTEND_DIR: static export directory (the Docker image sets /app/web).
# SEED_ON_START: load fleet:acme on start if it is missing (never wipes an existing graph).
PORT=8000
FRONTEND_DIR=
SEED_ON_START=true
