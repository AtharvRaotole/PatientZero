# FalkorDB. Local: scripts/start-falkordb.sh. FalkorDB Cloud: set FALKORDB_URL (rediss://user:pass@host:port)
# or HOST/PORT/USERNAME/PASSWORD (+ FALKORDB_SSL=true).
FALKORDB_URL=
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_GRAPH=fleet:acme
# Tenants (allowlist). Each tenant is its own graph fleet:<name>, seeded on start from data/fleet/<name>.json.
TENANTS=acme,globex

# Backend CORS (comma list) and optional regex, e.g. https://.*\.vercel\.app
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
CORS_ORIGIN_REGEX=

# Frontend (must be reachable from the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional OpenAI tool calling. Without a key everything runs on the deterministic router.
# auto: router first, LLM only when the router is not confident | deterministic | llm
AGENT_MODE=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS_TOOLS=400
LLM_MAX_TOKENS_SUMMARY=250
LLM_CACHE_TTL=1800
# Hard spend guard (server side). Over either limit the agent falls back to the deterministic router and says so
# in the trace. Usage (tokens per call, client IP hashed) is appended to .cache/llm_usage.jsonl.
OPENAI_DAILY_CALL_CAP=200
OPENAI_PER_IP_PER_MIN=10
# Directory for the usage log and the daily counter (survives restarts). Empty disables both files.
LLM_USAGE_DIR=

# Bring your own repo (BYO) scans. Deterministic: no LLM involved.
# Scans per minute per client IP (in-memory); scan graph lifetime in seconds (6 h); max live scan graphs;
# seconds per scan request.
BYO_RATE_LIMIT=5
BYO_TTL_SECONDS=21600
BYO_MAX_GRAPHS=50
BYO_SCAN_TIMEOUT=60

# Incident crew runs (POST /api/crew/run) per minute per client IP. Deterministic: no LLM involved.
CREW_PER_IP_PER_MIN=6

# Production single-service deploy (Dockerfile). Locally, Next.js dev serves the UI instead.
# FRONTEND_DIR: static export directory (the Docker image sets /app/web).
# SEED_ON_START: load every tenant graph (fleet:acme, fleet:globex) on start if missing (never wipes one).
PORT=8000
FRONTEND_DIR=
SEED_ON_START=true

# Admin token for destructive endpoints (POST /api/admin/reset, /api/memory/reset, /api/byo/cleanup,
# DELETE /api/playbooks). Send it as the X-Admin-Token header. Required on any public deploy; when empty
# (local development) those endpoints are open. Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Agent tool selection through our own MCP server (in-memory transport). off: direct calls.
MCP_AGENT=on
MCP_AGENT_TRANSPORT=memory

# Live OSV npm malware watch. WATCH_INTERVAL_S=0 disables the background poll (POST /api/watch/poll still works).
WATCH_INTERVAL_S=600
WATCH_MAX_BATCH=200
WATCH_DEPTH=6
WATCH_HTTP_TIMEOUT=10
WATCH_REPLAY_RATE=6

# FalkorDB queue-full (Max pending queries exceeded) retries; concurrency benchmark limits for POST /api/bench/run.
FALKORDB_BUSY_RETRIES=5
BENCH_SERVER_MAX_CLIENTS=50
BENCH_SERVER_MAX_DURATION_S=30
BENCH_SERVER_PROCS=2
