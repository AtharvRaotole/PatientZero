# FalkorDB (local: scripts/start-falkordb.sh; cloud: FalkorDB Cloud free tier host/port)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Backend
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Frontend (must be reachable from the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional LLM (OpenAI-compatible). Leave empty: core journey works without any LLM.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
OPENAI_API_KEY=
